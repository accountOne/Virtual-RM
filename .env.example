# Copy to .env (or export these in your shell) to configure the Phase 5 AI Reasoning layer.
# Never commit a real .env with a real API key.
#
# None of these are read via dotenv today (this repo has no dotenv dependency, matching how
# SEMANTIC_DEBUG is already used — export the var before `npm run dev`, e.g.
# `AI_PROVIDER=openai AI_API_KEY=sk-... npm run dev --prefix server`). Add dotenv later if a
# real deployment needs file-based env loading.

# Which AI provider to use. Without AI_API_KEY set, the app always falls back to the built-in
# deterministic MockReasoningProvider regardless of this value — see server/src/ai/ai-client.ts.
# Supported values once a real client is implemented: claude | openai | azure-openai | vng | local
AI_PROVIDER=mock

# Model name/deployment id for the chosen provider (e.g. claude-sonnet-5, gpt-4o).
AI_MODEL=

# API key for the chosen provider. Leave empty to use the mock provider (safe default for a
# demo/CI environment with no secret configured).
AI_API_KEY=

# Base URL override, e.g. for Azure OpenAI or a self-hosted/local model gateway.
AI_BASE_URL=

# Master switch for the Reasoning Engine (Model Router). false forces every query onto the
# plain deterministic Semantic Engine path, even ones that would otherwise trigger reasoning.
AI_REASONING_ENABLED=true

# Reasoning Engine's tool-call budget per question (spec §9). A plan longer than this is
# refused with a "câu hỏi quá phức tạp" answer rather than executed.
AI_MAX_STEPS=6

# Semantic Engine's existing confidence gate — below this, the engine asks a clarifying
# question instead of guessing (unchanged from before Phase 5; also read by the AI config
# loader so it's available to reasoning-side confidence decisions).
AI_CONFIDENCE_THRESHOLD=0.65

# Existing flag (predates Phase 5) — surfaces matchedTerms/entities/filters and, since
# Phase 5, structured reasoning metadata (intent/plan/toolsUsed/calculationsUsed, never the
# model's chain-of-thought) in the /api/virtual-rm/query response.
SEMANTIC_DEBUG=false

# ---- Login & Session Security (see docs/security/) ----------------------------------------

# Session timeout policy (spec §6). Checked on every authenticated request.
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Session cookie attributes (spec §4/§32). COOKIE_SECURE=true REQUIRES the app to be served
# over HTTPS — over plain HTTP (e.g. local dev) the browser silently drops a Secure cookie,
# which breaks login entirely. Only set true behind a real HTTPS deployment.
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# Explicit CORS allowlist, comma-separated (spec §21). Never falls back to `*` — the default
# when unset is the two local dev origins this repo's own ng serve setup uses.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Rate limiting (spec §23). Each can be turned off individually for local debugging; never
# disable in a shared/demo-hosted environment.
RATE_LIMIT_LOGIN=true
RATE_LIMIT_VIRTUAL_RM=true
RATE_LIMIT_TRANSACTIONS=true

# Per-username failed-login lockout (spec §23) — independent of the IP-based rate limiters
# above, so a distributed brute force against one account is still caught.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# Security audit log (spec §25) — server/data/audit-log.jsonl, masked (never raw
# password/OTP/PIN/CVV/token/session id).
AUDIT_ENABLED=true

# This is a DEMO. No real banking system is connected; every transaction is mock data (spec §31).
DEMO_MODE=true
